      "source": [
        "#| label: fig-code-questionnaire\n",
        "#| fig-cap: Code Questionnaire Results (Higher is Better)\n",
        "# This Python chunk expects a CSV at data/code_questionnaire.csv with columns:\n",
        "# metric,value  (e.g., \"Usefulness\",4.5)\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "df = pd.read_csv(\"data/code_questionnaire.csv\")  # <-- replace path if needed\n",
        "df = df.sort_values(\"value\", ascending=True)\n",
        "\n",
        "plt.figure()\n",
        "plt.barh(df[\"metric\"], df[\"value\"])  # no custom colors per style guidance\n",
        "plt.xlabel(\"Score\")\n",
        "plt.title(\"Code Questionnaire Results (n = {})\".format(len(df)))\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ],
      "id": "fig-code-questionnaire",
      "execution_count": null,
      "outputs": []
